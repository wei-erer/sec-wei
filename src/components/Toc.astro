---
const { headings = [] } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <aside class="toc" id="toc" aria-label="文章目录">
      <p class="toc-title">toc</p>
      <ul>
        {items.map((h) => (
          <li class={`depth-${h.depth}`}>
            <a href={`#${h.slug}`} data-toc-link>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
