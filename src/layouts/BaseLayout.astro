---
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '@fontsource/vt323/latin-400.css';
import '../styles/global.css';

import site from '../site.config.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';

const {
  title,
  description = site.description,
  type = 'website',
  image,
  noindex = false,
  bodyClass = '',
} = Astro.props;

const pageTitle = title ? `${title} — ${site.title}` : `${site.title} · ${site.tagline}`;
const siteRoot = site.url.replace(/\/+$/, '');
const base = site.base === '/' ? '' : site.base.replace(/\/+$/, '');
const canonical = `${siteRoot}${Astro.url.pathname}`;
const ogImage = image || `${siteRoot}${base}/og-default.png`;
---

<!doctype html>
<html lang="zh-CN" data-theme={site.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(',')} />
    <meta name="author" content={site.author.name} />
    <meta name="theme-color" content={site.defaultTheme === 'light' ? '#eef4ec' : '#040705'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={`${base}/rss.xml`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline define:vars={{ defaultTheme: site.defaultTheme }}>
      (function () {
        var theme = defaultTheme;
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
          // ?theme=light 可直接预览另一种主题（不写入 localStorage）
          var qp = new URLSearchParams(location.search).get('theme');
          if (qp === 'light' || qp === 'dark') theme = qp;
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <div class="crt" aria-hidden="true"></div>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">跳到正文</a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <SearchOverlay />

    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="图片预览">
      <img alt="" />
    </div>

    {site.analytics.enabled && (
      <script is:inline src={site.analytics.busuanziUrl} defer></script>
    )}

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
